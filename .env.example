# Copy this file to .env for local development.
# Never commit real credentials. The local Laya demo does not need API keys;
# they are only used by hosted comparison/teacher scripts.

# Optional: OpenAI-hosted evaluation or teacher calls.
OPENAI_API_KEY=

# Optional: DeepSeek-hosted evaluation or teacher calls.
DEEPSEEK_API_KEY=

# Optional: default Kaggle dataset owner for training/make_kaggle_dataset.py.
# Kaggle API authentication itself is read by the CLI from ~/.kaggle/access_token.
KAGGLE_USERNAME=

# Optional: serve a different checkpoint instead of models/active.
# Example: JEV_MODEL=models/kaggle-out-v7/laya-dealership-routing
JEV_MODEL=

# Optional: local booking store path.
# Defaults to data/bookings.jsonl.
JEV_BOOKINGS=
