          "p_needs_human": 1.0,
          "is_safe_to_drive": 1,
          "needs_human": 0,
          "why": "stranded"
        },
        {
          "id": "sev-11",
          "text": "There's a burning smell and smoke coming through the vents.",
          "p_is_safe_to_drive": 1.0,
          "p_needs_human": 1.0,
          "is_safe_to_drive": 1,
          "needs_human": 0,
          "why": "fire risk"
        },
        {
          "id": "sev-12",
          "text": "The transmission just gave out while I was in traffic, it won't move.",
          "p_is_safe_to_drive": 1.0,
          "p_needs_human": 1.0,
          "is_safe_to_drive": 1,
          "needs_human": 0,
          "why": "immobile in traffic"
        },
        {
          "id": "sev-13",
          "text": "The tyre blew out and I'm on the hard shoulder.",
