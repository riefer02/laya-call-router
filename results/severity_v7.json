          "p_needs_human": 1.0,
          "is_safe_to_drive": 1,
          "needs_human": 0,
          "why": "off the road"
        },
        {
          "id": "sev-17",
          "text": "The wheel came loose and I've stopped, I'm not driving it anywhere.",
